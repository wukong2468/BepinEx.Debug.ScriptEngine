<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>McpSmokeTests</AssemblyName>
    <RootNamespace>McpSmokeTests</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyTitle>ScriptDebugEngine MCP smoke tests</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="Cases\*.cs" />
    <!-- 直接链接被测源码：Mcp 层刻意不依赖 UnityEngine / BepInEx，所以可以脱离游戏跑 -->
    <Compile Include="..\..\ScriptDebugEngine\Mcp\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.10.4" />
    <!-- 只用于测试：作为"独立解析器"验证被测服务器产出的 JSON（刻意不复用被测自己的 Json 类） -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
