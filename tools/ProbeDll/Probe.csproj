<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Probe</AssemblyName>
    <RootNamespace>Probe</RootNamespace>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只用于编译：不要把 UnityEngine.dll 复制到 BepInEx\scripts 里 -->
    <PackageReference Include="UnityEngine.Modules" Version="5.6.4" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- 只用于编译：探针需要触发宿主的 Config.Reload()，用来验证动态配置路径 -->
    <PackageReference Include="BepInEx.Core" Version="5.4.21" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
